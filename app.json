{
  "expo": {
    "name": "まちのかけひき",
    "slug": "machi-no-kakehiki",
    "description": "政策と戦略を選びながら、50年間の街の発展を導く政策選択型まちづくりゲーム",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/machi-no-kakehiki-icon.png",
    "scheme": "machinokakehiki",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E8DFCC",
    "ios": {
      "icon": "./assets/images/machi-no-kakehiki-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.taku.machinokakehiki",
      "buildNumber": "1",
      "userInterfaceStyle": "light",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.taku.machinokakehiki",
      "versionCode": 1,
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#E8DFCC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D2538",
          "image": "./assets/images/machi-no-kakehiki-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58eb8853-563f-4b61-8ea5-9e6a5c154005"
      }
    },
    "owner": "taku2003"
  }
}
